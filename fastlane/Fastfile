# The one store step that still needs a web session: the App Privacy answers, which the App Store
# Connect API has no call for. The rest of a release is App/appstore.sh, with the API key alone;
# .claude/skills/release-to-app-store has the order. Run this only when the answers change.
#
#   (eval "$(optokens env calcgrid)"; fastlane privacy)
#
# Signs in with FASTLANE_USER and FASTLANE_SESSION — the `fastlane spaceauth` session kept in the
# `calcgrid` profile, which is the developer account's rather than that app's. It lasts about a month.

skip_docs

desc "Send the App Privacy answers: \"Data Not Collected\", for the reasons docs/privacy.md gives."
lane :privacy do
  # With a session there is no password to give, but fastlane asks at the terminal for one it does not have.
  ENV["FASTLANE_PASSWORD"] ||= "unused-with-session"
  upload_app_privacy_details_to_app_store(app_identifier: "com.sunfmin.chessmirror",
                                          json_path: File.expand_path("app-privacy.json", __dir__))
end
